# Copy to .env.local and populate real values for local development
# Supabase project values
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key...
REACT_APP_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Demo mode: set to 'true' to enable local demo user (bypasses Supabase auth)
REACT_APP_DEMO_MODE=true

# Other environment variables used by the app
REACT_APP_API_BASE_URL=http://localhost:3000
